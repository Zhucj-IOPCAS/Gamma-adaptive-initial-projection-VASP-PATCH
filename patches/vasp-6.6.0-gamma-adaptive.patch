+!**********************************************************************
+!> Compute center-dependent real-space overlaps using BLAS ZDOTC.
+!>
+!> This routine evaluates the Gamma-adaptive overlap tensor
+!>
+!>   S(m, n, l) = <psi_{m,k1} | region_l | psi_{n,k2}>
+!>
+!> where each Wannier orbital l defines its own Wigner-Seitz reference
+!> region through TAU_WANN(:, l). The real-space grid phase and PAW
+!> projector phase both use the same minimum-image convention.
+!**********************************************************************
+      SUBROUTINE CALC_OVERLAP_CLUSTER_BLAS(W, K1, K2, ISP, P, CQIJ, LATT_CUR, T_INFO, NWANN, TAU_WANN, S)
+      USE prec
+      USE constant
+      USE poscar
+      USE pseudo
+      USE lattice
+      USE full_kpoints
+      USE wave_high
+      USE dfast
+      USE sym_prec
+      USE paw
+
+      IMPLICIT NONE
+
+      TYPE(wavespin)  :: W
+      TYPE(potcar)    :: P(:)
+      TYPE(latt)      :: LATT_CUR
+      TYPE(type_info) :: T_INFO
+
+      REAL(q) :: K1(3), K2(3)
+      INTEGER :: ISP, NWANN
+      OVERLAP :: CQIJ(:,:,:,:)
+      REAL(q) :: TAU_WANN(3, NWANN)
+      GDEF    :: S(W%WDES%NB_TOT, W%WDES%NB_TOT, NWANN)
+
+      TYPE(wavefun1) :: WQ
+      TYPE(wavespin) :: WP
+      TYPE(wavefuna) :: WK, WHAM
+      TYPE(wavedes1), TARGET :: WDESK, WDESQ
+      TYPE(rotation_handle)  :: ROT_HANDLE
+      TYPE(wavefun1), ALLOCATABLE :: WK_ALL(:)
+
+      INTEGER :: M_GLB, N_GLB
+      INTEGER :: NX, NY, NZ, N1, N2, N3, IND_G
+      INTEGER :: L_ORB, IPRO
+      INTEGER :: IR1, IR2, IR3
+      INTEGER :: NBANDS, NSTRIP, NSTRIP_ACT
+      INTEGER :: N, NP, NK, NQ, NPOS
+
+      REAL(q) :: DK(3), DK1(3), DK2(3)
+      REAL(q) :: F1, F2, F3, A1, A2, A3
+      REAL(q) :: ARG, RA_FRAC(3), PHASE(3)
+
+      COMPLEX(q), ALLOCATABLE :: SV(:)
+      COMPLEX(q), ALLOCATABLE :: PHASE_ATOM(:,:), PHASE_GRID(:,:)
+
+      INTEGER :: ISPINOR, NIP, NIS, NT, NI, LMMAXC, L, NPRO
+      COMPLEX(q) :: PHASE_FAC
+
+      COMPLEX(q), ALLOCATABLE :: V_R_SOFT(:),V_R_HARD(:)
+      COMPLEX(q), ALLOCATABLE :: C_SOFT_BANDS(:)
+      COMPLEX(q) :: C_HARD
+      COMPLEX(q), EXTERNAL :: ZDOTC
+
+      INTEGER :: NP_GRID,NPRO_TOT,NPWS_K,NPWS_Q
+      INTEGER :: NK1, NK2, I
+
+      ! Minimum-image search variables for the Wigner-Seitz reference cell.
+      REAL(q) :: D_FRAC(3), D_CART(3), D_MIN, D_TEST
+      INTEGER :: I1, I2, I3
+      INTEGER :: IR1_BASE, IR2_BASE, IR3_BASE
+      INTEGER :: OPT_I1, OPT_I2, OPT_I3
+
+      S = 0.0_q
+
+      WP = W
+      WP%WDES => WDES_FULL_PEAD
+
+      NK1 = KPOINT_IN_FULL_GRID(K1, KPOINTS_FULL)
+      NK2 = KPOINT_IN_FULL_GRID(K2, KPOINTS_FULL)
+
+      DO I = 1, 3
+         DK1(I) = KPOINTS_FULL%VKPT(I, NK1)
+         DK2(I) = KPOINTS_FULL%VKPT(I, NK2)
+      ENDDO
+      DK = DK2 - DK1
+
+      NX = W%WDES%GRID%NGX
+      NY = W%WDES%GRID%NGY
+      NZ = W%WDES%GRID%NGZ
+
+      F1 = 1._q / NX
+      F2 = 1._q / NY
+      F3 = 1._q / NZ
+
+      NP_GRID = W%WDES%GRID%RL%NP
+      NPRO_TOT = W%WDES%NPRO
+
+      CALL CHECK_FULL_KPOINTS
+
+      ROT_HANDLE%LSETUP = .FALSE.
+      NSTRIP = NSTRIP_STANDARD
+
+!**********************************************************************
+! Part 1: Prepare left states at K1.
+!**********************************************************************
+      NK = KPOINT_IN_FULL_GRID(K1, KPOINTS_FULL)
+      CALL SETWDES(WP%WDES, WDESK, NK)
+
+      ! Rotate from the irreducible representative if K1 is symmetry related.
+      IF (NK == KPOINTS_FULL%NEQUIV(NK)) THEN
+         WK = ELEMENTS(WP, WDESK, ISP)
+      ELSE
+         CALL NEWWAVA(WK, WDESK, WDESK%NBANDS)
+         CALL WA_ROTATE(WP, P, LATT_CUR, ISP, WK)
+      ENDIF
+
+      ! Store all left bands as wavefun1 objects.
+      ALLOCATE(WK_ALL(W%WDES%NB_TOT))
+      DO M_GLB = 1, W%WDES%NB_TOT
+         CALL NEWWAV(WK_ALL(M_GLB), WDESK, .TRUE.)
+      ENDDO
+
+      ! Copy locally owned bands and FFT them to real space.
+      DO M_GLB = 1, W%WDES%NB_TOT
+         IF (MOD(M_GLB - 1, WDESK%NB_PAR) + 1 == WDESK%NB_LOW) THEN
+            N = 1 + (M_GLB - 1) / WDESK%NB_PAR
+
+            WK_ALL(M_GLB)%CW(1:WDESK%NGVECTOR*WDESK%NRSPINORS) = &
+               WK%CW(1:WDESK%NGVECTOR*WDESK%NRSPINORS,N)
+
+            IF (W%WDES%LOVERL) THEN
+               WK_ALL(M_GLB)%CPROJ(1:WDESK%NPROD) = WK%CPROJ(1:WDESK%NPROD, N)
+            ENDIF
+
+            CALL FFTWAV_W1(WK_ALL(M_GLB))
+         ENDIF
+      ENDDO
+
+#ifdef MPI
+      ! Broadcast each left-band real-space state from its band owner.
+      IF (WDESK%DO_REDIS) THEN
+         DO M_GLB = 1, W%WDES%NB_TOT
+            CALL M_bcast_z_from(WDESK%COMM_INTER, WK_ALL(M_GLB)%CR(1), &
+                                WDESK%GRID%MPLWV * WDESK%NRSPINORS, MOD(M_GLB - 1, WDESK%NB_PAR) + 1)
+
+            IF (W%WDES%LOVERL) THEN
+               CALL M_bcast_z_from(WDESK%COMM_INTER, WK_ALL(M_GLB)%CPROJ(1), &
+                                   WDESK%NPROD, MOD(M_GLB - 1, WDESK%NB_PAR) + 1)
+            ENDIF
+         ENDDO
+
+#ifdef MPI_barrier_after_bcast
+         CALLMPI( M_barrier(W%WDES%COMM_INTER) )
+#endif
+      ENDIF
+#endif
+
+!**********************************************************************
+! Part 2: Precompute Wigner-Seitz phase factors.
+!**********************************************************************
+      ALLOCATE(PHASE_ATOM(NPRO_TOT, NWANN))
+      PHASE_ATOM = (0.0_q, 0.0_q)
+
+      DO L_ORB = 1, NWANN
+         DO ISPINOR = 0, W%WDES%NRSPINORS - 1
+            NPRO = ISPINOR * (NPRO_TOT / 2)
+            NIS = 1
+
+            DO NT = 1, W%WDES%NTYP
+               LMMAXC = W%WDES%LMMAX(NT)
+
+               IF (LMMAXC /= 0) THEN
+                  DO NI = NIS, W%WDES%NITYP(NT) + NIS - 1
+                     NIP = NI_GLOBAL(NI, W%WDES%COMM_INB)
+                     RA_FRAC = T_INFO%POSION(:, NIP)
+
+                     ! Find the nearest periodic image of this atom relative to TAU_WANN.
+                     IR1_BASE = NINT(TAU_WANN(1, L_ORB) - RA_FRAC(1))
+                     IR2_BASE = NINT(TAU_WANN(2, L_ORB) - RA_FRAC(2))
+                     IR3_BASE = NINT(TAU_WANN(3, L_ORB) - RA_FRAC(3))
+
+                     D_MIN = 1.0E30_q
+                     OPT_I1 = IR1_BASE
+                     OPT_I2 = IR2_BASE
+                     OPT_I3 = IR3_BASE
+
+                     DO I1 = -1, 1
+                        DO I2 = -1, 1
+                           DO I3 = -1, 1
+                              D_FRAC(1) = RA_FRAC(1) + (IR1_BASE + I1) - TAU_WANN(1, L_ORB)
+                              D_FRAC(2) = RA_FRAC(2) + (IR2_BASE + I2) - TAU_WANN(2, L_ORB)
+                              D_FRAC(3) = RA_FRAC(3) + (IR3_BASE + I3) - TAU_WANN(3, L_ORB)
+
+                              D_CART(1) = D_FRAC(1)*LATT_CUR%A(1,1) + D_FRAC(2)*LATT_CUR%A(1,2) + D_FRAC(3)*LATT_CUR%A(1,3)
+                              D_CART(2) = D_FRAC(1)*LATT_CUR%A(2,1) + D_FRAC(2)*LATT_CUR%A(2,2) + D_FRAC(3)*LATT_CUR%A(2,3)
+                              D_CART(3) = D_FRAC(1)*LATT_CUR%A(3,1) + D_FRAC(2)*LATT_CUR%A(3,2) + D_FRAC(3)*LATT_CUR%A(3,3)
+
+                              D_TEST = D_CART(1)**2 + D_CART(2)**2 + D_CART(3)**2
+
+                              IF (D_TEST < D_MIN) THEN
+                                 D_MIN = D_TEST
+                                 OPT_I1 = IR1_BASE + I1
+                                 OPT_I2 = IR2_BASE + I2
+                                 OPT_I3 = IR3_BASE + I3
+                              ENDIF
+                           ENDDO
+                        ENDDO
+                     ENDDO
+
+                     IR1 = OPT_I1
+                     IR2 = OPT_I2
+                     IR3 = OPT_I3
+
+                     ! Keep the original phase convention.
+                     ARG = TPI * ((IR1 + RA_FRAC(1))*DK(1) + &
+                                  (IR2 + RA_FRAC(2))*DK(2) + &
+                                  (IR3 + RA_FRAC(3))*DK(3))
+
+                     PHASE_FAC = CMPLX(COS(ARG), SIN(ARG), q)
+
+                     DO L = 1, LMMAXC
+                        IF (L + NPRO <= NPRO_TOT) PHASE_ATOM(L + NPRO, L_ORB) = PHASE_FAC
+                     ENDDO
+
+                     NPRO = LMMAXC + NPRO
+                  ENDDO
+               ENDIF
+
+               NIS = NIS + W%WDES%NITYP(NT)
+            ENDDO
+         ENDDO
+      ENDDO
+
+      ALLOCATE(PHASE_GRID(NP_GRID, NWANN))
+
+      DO L_ORB = 1, NWANN
+         DO N3 = 0, NZ - 1
+            A3 = N3 * F3
+            DO N2 = 0, NY - 1
+               A2 = N2 * F2
+               DO N1 = 0, NX - 1
+                  A1 = N1 * F1
+
+                  ! Find the nearest periodic image of this grid point relative to TAU_WANN.
+                  IR1_BASE = NINT(TAU_WANN(1, L_ORB) - A1)
+                  IR2_BASE = NINT(TAU_WANN(2, L_ORB) - A2)
+                  IR3_BASE = NINT(TAU_WANN(3, L_ORB) - A3)
+
+                  D_MIN = 1.0E30_q
+                  OPT_I1 = IR1_BASE
+                  OPT_I2 = IR2_BASE
+                  OPT_I3 = IR3_BASE
+
+                  DO I1 = -1, 1
+                     DO I2 = -1, 1
+                        DO I3 = -1, 1
+                           D_FRAC(1) = A1 + (IR1_BASE + I1) - TAU_WANN(1, L_ORB)
+                           D_FRAC(2) = A2 + (IR2_BASE + I2) - TAU_WANN(2, L_ORB)
+                           D_FRAC(3) = A3 + (IR3_BASE + I3) - TAU_WANN(3, L_ORB)
+
+                           D_CART(1) = D_FRAC(1)*LATT_CUR%A(1,1) + D_FRAC(2)*LATT_CUR%A(1,2) + D_FRAC(3)*LATT_CUR%A(1,3)
+                           D_CART(2) = D_FRAC(1)*LATT_CUR%A(2,1) + D_FRAC(2)*LATT_CUR%A(2,2) + D_FRAC(3)*LATT_CUR%A(2,3)
+                           D_CART(3) = D_FRAC(1)*LATT_CUR%A(3,1) + D_FRAC(2)*LATT_CUR%A(3,2) + D_FRAC(3)*LATT_CUR%A(3,3)
+
+                           D_TEST = D_CART(1)**2 + D_CART(2)**2 + D_CART(3)**2
+
+                           IF (D_TEST < D_MIN) THEN
+                              D_MIN = D_TEST
+                              OPT_I1 = IR1_BASE + I1
+                              OPT_I2 = IR2_BASE + I2
+                              OPT_I3 = IR3_BASE + I3
+                           ENDIF
+                        ENDDO
+                     ENDDO
+                  ENDDO
+
+                  IR1 = OPT_I1
+                  IR2 = OPT_I2
+                  IR3 = OPT_I3
+
+                  ARG = TPI * ((IR1 + A1)*DK(1) + &
+                               (IR2 + A2)*DK(2) + &
+                               (IR3 + A3)*DK(3))
+
+                  IND_G = N1 + N2*NX + N3*NX*NY + 1
+                  PHASE_GRID(IND_G, L_ORB) = CMPLX(COS(ARG), SIN(ARG), q)
+               ENDDO
+            ENDDO
+         ENDDO
+      ENDDO
+
+!**********************************************************************
+! Part 3: Prepare right states at K2 and evaluate vector inner products.
+!**********************************************************************
+      NQ = KPOINT_IN_FULL_GRID(K2, KPOINTS_FULL)
+      CALL SETWDES(WP%WDES, WDESQ, NQ)
+
+      CALL NEWWAV(WQ, WDESQ, .TRUE.)
+      CALL NEWWAVA(WHAM, WDESK, NSTRIP)
+
+      ALLOCATE(SV(WDESQ%GRID%MPLWV))
+
+      CALL SET_PHASE_SHIFT(K1, K2, PHASE)
+      CALL SET_PHASE_SHIFT_GRID_RSPACE(PHASE, WDESQ, SV)
+
+      ! IF (W%WDES%COMM%NODE_ME == 1) THEN
+      !    WRITE(*,*) '========== PHASE DEBUG START =========='
+      !    WRITE(*,'(A,3F12.6)') 'K1 (Input)           = ', K1
+      !    WRITE(*,'(A,3F12.6)') 'K2 (Input)           = ', K2
+      !    WRITE(*,'(A,3F12.6)') 'K1_1stBZ (VKPT)      = ', KPOINTS_FULL%VKPT(:, NK1)
+      !    WRITE(*,'(A,3F12.6)') 'K2_1stBZ (VKPT)      = ', KPOINTS_FULL%VKPT(:, NK2)
+      !    WRITE(*,'(A,3F12.6)') 'DK (Custom DK2-DK1)  = ', DK
+      !    WRITE(*,'(A,3F12.6)') 'PHASE (VASP return)  = ', PHASE
+      !    WRITE(*,*) '--- Phase Values at Grid Point 1 ---'
+      !    WRITE(*,'(A,2F12.6)') 'SV(IND_G=1)          = ', SV(1)
+      !    WRITE(*,'(A,2F12.6)') 'PHASE_GRID(1, ORB=1) = ', PHASE_GRID(1, 1)
+
+      !    IF (NWANN >= 2) THEN
+      !       WRITE(*,'(A,2F12.6)') 'PHASE_GRID(1, ORB=2) = ', PHASE_GRID(1, 2)
+      !    ENDIF
+
+      !    WRITE(*,*) '========== PHASE DEBUG END =========='
+      ! ENDIF
+
+      ALLOCATE(V_R_SOFT(NP_GRID))
+      ALLOCATE(C_SOFT_BANDS(W%WDES%NB_TOT))
+
+      IF (W%WDES%LOVERL) ALLOCATE(V_R_HARD(NPRO_TOT))
+
+      NBANDS = WP%WDES%NBANDS
+
+      strips: DO NPOS = 1, NBANDS, NSTRIP
+         NSTRIP_ACT = MIN(NBANDS + 1 - NPOS, NSTRIP)
+
+         instrip: DO N = NPOS, NPOS + NSTRIP_ACT - 1
+            NP = N - NPOS + 1
+
+            IF (NQ == KPOINTS_FULL%NEQUIV(NQ)) THEN
+               CALL W1_COPY(ELEMENT(WP, WDESQ, N, ISP), WQ)
+            ELSE
+               CALL W1_ROTATE(WP, P, LATT_CUR, N, ISP, ROT_HANDLE, WQ)
+            ENDIF
+
+            CALL FFTWAV_W1(WQ)
+            CALL OVERL_AND_APPLY_PHASE_SHIFT(PHASE, T_INFO, CQIJ, WDESQ, WQ, WHAM%CPROJ(:, NP))
+
+            N_GLB = (N - 1)*W%WDES%NB_PAR + W%WDES%NB_LOW
+
+            DO L_ORB = 1, NWANN
+               C_SOFT_BANDS = CMPLX(0.0_q,0.0_q,q)
+
+               ! Sum the soft overlap over both internal spinor blocks.
+               DO ISPINOR = 0, W%WDES%NRSPINORS-1
+                  NPWS_K = ISPINOR*WDESK%GRID%MPLWV
+                  NPWS_Q = ISPINOR*WDESQ%GRID%MPLWV
+
+                  DO IND_G = 1, NP_GRID
+                     V_R_SOFT(IND_G) = WQ%CR(IND_G+NPWS_Q)* &
+                        PHASE_GRID(IND_G,L_ORB)*SV(IND_G)
+                  ENDDO
+
+                  DO M_GLB = 1, W%WDES%NB_TOT
+                     C_SOFT_BANDS(M_GLB) = C_SOFT_BANDS(M_GLB) + &
+                        ZDOTC(NP_GRID,WK_ALL(M_GLB)%CR(1+NPWS_K),1,V_R_SOFT,1)* &
+                        CMPLX(1.0_q/W%WDES%GRID%NPLWV,0.0_q,q)
+                  ENDDO
+               ENDDO
+
+               IF (W%WDES%LOVERL) THEN
+                  DO IPRO = 1, NPRO_TOT
+                     V_R_HARD(IPRO) = WHAM%CPROJ(IPRO,NP)*PHASE_ATOM(IPRO,L_ORB)
+                  ENDDO
+               ENDIF
+
+               DO M_GLB = 1, W%WDES%NB_TOT
+                  C_HARD = CMPLX(0.0_q,0.0_q,q)
+                  IF (W%WDES%LOVERL) C_HARD = &
+                     ZDOTC(NPRO_TOT,WK_ALL(M_GLB)%CPROJ,1,V_R_HARD,1)
+
+                  S(M_GLB,N_GLB,L_ORB) = C_SOFT_BANDS(M_GLB)+C_HARD
+               ENDDO
+            ENDDO
+         ENDDO instrip
+      ENDDO strips
+
+      CALLMPI( M_sum_g(WDESK%COMM_KIN, S(1,1,1), W%WDES%NB_TOT*W%WDES%NB_TOT*NWANN) )
+
+!**********************************************************************
+! Part 4: Release local work arrays.
+!**********************************************************************
+      IF (NK /= KPOINTS_FULL%NEQUIV(NK)) CALL DELWAVA(WK)
+
+      DO N = 1, W%WDES%NB_TOT
+         CALL DELWAV(WK_ALL(N), .TRUE.)
+      ENDDO
+
+      DEALLOCATE(WK_ALL, SV, PHASE_ATOM, PHASE_GRID)
+      DEALLOCATE(V_R_SOFT,C_SOFT_BANDS)
+
+      IF (ALLOCATED(V_R_HARD)) DEALLOCATE(V_R_HARD)
+
+      CALL DELWAV(WQ, .TRUE.)
+      CALL DELWAVA(WHAM)
+
+      RETURN
+      END SUBROUTINE CALC_OVERLAP_CLUSTER_BLAS
 !******************** SUBROUTINE ***************************************
